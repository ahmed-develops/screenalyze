# OpenAI API Key for Screenalyze live multimodal visual analysis with GPT-4o
# Get a key from OpenAI Platform: https://platform.openai.com/api-keys
EXPO_PUBLIC_OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Backend Service
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["*"]

# Email Service (Nodemailer-style SMTP configuration)
# Leave SMTP_HOST blank for local dev console transport (OTP codes printed to terminal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=no-reply@screenalyze.ai
SMTP_FROM_NAME=Screenalyze
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# MongoDB Atlas Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=screenalyze
